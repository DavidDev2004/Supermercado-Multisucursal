	partition I2-E06_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="SELECT#(lf)    CodigoCliente,#(lf)    Nombres+' '+Apellidos AS Cliente,#(lf)    Departamento,#(lf)    Telefono#(lf)FROM Tbl_Clientes#(lf)WHERE Estado='Activo' AND CodigoCliente IN#(lf)    (SELECT CodigoCliente FROM Tbl_Ventas#(lf)     WHERE Estado='Confirmada' AND CodigoVenta IN#(lf)        (SELECT CodigoVenta FROM Tbl_Pagos#(lf)         WHERE Estado='Aplicado' AND Monto>#(lf)            (SELECT AVG(Monto) FROM Tbl_Pagos WHERE Estado='Aplicado')))#(lf)ORDER BY Apellidos ASC;"])
				in
				    Origen

	annotation PBI_ResultType = Table

