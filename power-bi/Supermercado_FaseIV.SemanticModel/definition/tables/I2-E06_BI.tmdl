table I2-E06_BI
	lineageTag: 660c79b8-7b2d-5800-accf-868ee18905e9

	column CodigoCliente
		dataType: int64
		formatString: 0
		lineageTag: b8bc30c2-907b-5798-bf2a-56b44c405535
		summarizeBy: none
		sourceColumn: CodigoCliente

	column Cliente
		dataType: string
		lineageTag: 5604c324-202d-508a-9ef8-6526558531c8
		summarizeBy: none
		sourceColumn: Cliente

	column Departamento
		dataType: string
		lineageTag: e8c81175-e18f-5b43-93d9-5704bdb96313
		summarizeBy: none
		sourceColumn: Departamento

	column Telefono
		dataType: string
