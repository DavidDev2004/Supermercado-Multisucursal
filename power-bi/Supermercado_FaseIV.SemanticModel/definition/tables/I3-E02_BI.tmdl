	column SituacionIngreso
		dataType: string
		lineageTag: 81692441-b182-5543-b54e-5dafc17b16a3
		summarizeBy: none
		sourceColumn: SituacionIngreso

	partition I3-E02_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="SELECT i.CodigoInventario, i.CodigoSucursal, i.CodigoProducto,#(lf)       i.Existencia, i.ExistenciaMinima,#(lf)       CASE WHEN i.Existencia < i.ExistenciaMinima#(lf)            THEN i.ExistenciaMinima-i.Existencia ELSE CAST(0 AS decimal(12,2)) END AS Faltante,#(lf)       CAST(ROUND((CASE WHEN i.Existencia<i.ExistenciaMinima THEN i.ExistenciaMinima-i.Existencia ELSE 0 END)*i.CostoPromedio,2) AS decimal(18,2)) AS ValorFaltante,#(lf)       CASE WHEN i.FechaUltimoIngreso IS NULL THEN NULL#(lf)            ELSE DATEDIFF(DAY,i.FechaUltimoIngreso,'20260930') END AS DiasSinIngreso,#(lf)       CASE WHEN i.FechaUltimoIngreso IS NULL THEN 'Sin ingreso'#(lf)            ELSE 'Con ingreso' END AS SituacionIngreso#(lf)FROM dbo.Tbl_Inventario AS i#(lf)WHERE i.Existencia<=i.ExistenciaMinima AND i.CostoPromedio>0#(lf)ORDER BY ValorFaltante DESC, i.CodigoInventario;"])
				in
				    Origen

	annotation PBI_ResultType = Table

