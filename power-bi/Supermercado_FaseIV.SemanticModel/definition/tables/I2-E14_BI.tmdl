	partition I2-E14_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate_PRUEBAS", [Query="SELECT e.CodigoEmpleado, e.CodigoSucursal,#(lf)       e.Nombres + ' ' + e.Apellidos AS Empleado,#(lf)       CAST(e.Salario AS decimal(18,2)) AS Salario#(lf)FROM dbo.Tbl_Empleados AS e#(lf)WHERE e.CodigoEmpleado = 1;"])
				in
				    Origen

	annotation PBI_ResultType = Table

