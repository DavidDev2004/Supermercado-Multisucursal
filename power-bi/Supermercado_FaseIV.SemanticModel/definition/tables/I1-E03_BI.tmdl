	column ImporteCompra
		dataType: double
		formatString: #,0.00
		lineageTag: 2768f3da-6ef9-50d4-a527-4d2991179637
		summarizeBy: sum
		sourceColumn: ImporteCompra

	partition I1-E03_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="WITH Totales AS (#(lf)    SELECT CodigoCompra,#(lf)           SUM(Cantidad * CostoUnitario - Descuento) AS ImporteCompra#(lf)    FROM dbo.Tbl_ComprasDetalle#(lf)    GROUP BY CodigoCompra#(lf))#(lf)SELECT c.CodigoCompra, c.NumeroCompra, c.FechaCompra,#(lf)       pr.Nombre AS Proveedor, s.Nombre AS Sucursal,#(lf)       e.Nombres + ' ' + e.Apellidos AS Empleado,#(lf)       CAST(ROUND(t.ImporteCompra, 2) AS decimal(18,2)) AS ImporteCompra#(lf)FROM dbo.Tbl_Compras AS c#(lf)JOIN Totales AS t ON t.CodigoCompra = c.CodigoCompra#(lf)JOIN dbo.Tbl_Proveedores AS pr ON pr.CodigoProveedor = c.CodigoProveedor#(lf)JOIN dbo.Tbl_Sucursales AS s ON s.CodigoSucursal = c.CodigoSucursal#(lf)JOIN dbo.Tbl_Empleados AS e ON e.CodigoEmpleado = c.CodigoEmpleado#(lf)WHERE c.Estado = 'Recibida'#(lf)  AND c.FechaCompra >= '20260901' AND c.FechaCompra < '20261001'#(lf)ORDER BY ImporteCompra DESC, c.CodigoCompra;"])
				in
				    Origen

	annotation PBI_ResultType = Table

