	partition I2-E15_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate_PRUEBAS", [Query="WITH Practicas AS (#(lf)    SELECT v.Decision, v.NIT, v.NumeroVenta#(lf)    FROM (VALUES#(lf)        ('NO', 'I2E15638B1CE7EB1542', 'I2-E15-3243CE0A052A4894844FA9'),#(lf)        ('SI', 'I2E1548F48CBA74FE4B', 'I2-E15-9287DE7FEC6C4195A2A587')#(lf)    ) AS v(Decision, NIT, NumeroVenta)#(lf))#(lf)SELECT p.Decision, p.NIT, p.NumeroVenta,#(lf)       CASE WHEN c.CodigoCliente IS NULL THEN 0 ELSE 1 END AS ExisteCliente,#(lf)       CASE WHEN v.CodigoVenta IS NULL THEN 0 ELSE 1 END AS ExisteVenta#(lf)FROM Practicas AS p#(lf)LEFT JOIN dbo.Tbl_Clientes AS c ON c.NIT = p.NIT#(lf)LEFT JOIN dbo.Tbl_Ventas AS v ON v.NumeroVenta = p.NumeroVenta;"])
				in
				    Origen

	annotation PBI_ResultType = Table

