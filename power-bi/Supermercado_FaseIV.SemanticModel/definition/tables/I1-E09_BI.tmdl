	partition I1-E09_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="-- Ajustes antiguos sin FechaAplicacion no se atribuyen a septiembre; no se inventan fechas.#(lf)WITH Movimientos AS (#(lf)    SELECT c.FechaRecepcion AS Fecha, c.NumeroCompra AS Documento,#(lf)           CAST('Compra recibida' AS varchar(20)) AS TipoEvento,#(lf)           c.CodigoSucursal,#(lf)           CAST(ROUND(SUM(d.Cantidad * d.CostoUnitario - d.Descuento),2) AS decimal(18,2)) AS Monto,#(lf)           c.Estado#(lf)    FROM dbo.Tbl_Compras AS c#(lf)    JOIN dbo.Tbl_ComprasDetalle AS d ON d.CodigoCompra = c.CodigoCompra#(lf)    WHERE c.Estado = 'Recibida' AND c.FechaRecepcion >= '20260901' AND c.FechaRecepcion < '20261001'#(lf)    GROUP BY c.CodigoCompra, c.FechaRecepcion, c.NumeroCompra, c.CodigoSucursal, c.Estado#(lf)    UNION ALL#(lf)    SELECT a.FechaAplicacion, a.NumeroAjuste, CAST('Ajuste aplicado' AS varchar(20)),#(lf)           a.CodigoSucursal,#(lf)           CASE WHEN COUNT(d.CostoUnitario) = COUNT(*)#(lf)                THEN CAST(ROUND(SUM(d.Cantidad * d.CostoUnitario), 2) AS decimal(18,2))#(lf)                ELSE NULL END,#(lf)           a.Estado#(lf)    FROM dbo.Tbl_AjustesInventario AS a#(lf)    JOIN dbo.Tbl_AjustesInventarioDetalle AS d ON d.CodigoAjuste = a.CodigoAjuste#(lf)    WHERE a.Estado = 'Aplicado' AND a.FechaAplicacion >= '20260901' AND a.FechaAplicacion < '20261001'#(lf)    GROUP BY a.CodigoAjuste, a.FechaAplicacion, a.NumeroAjuste, a.CodigoSucursal, a.Estado#(lf))#(lf)SELECT Fecha, Documento, TipoEvento, CodigoSucursal, Monto, Estado#(lf)FROM Movimientos#(lf)ORDER BY Fecha, TipoEvento, Documento;"])
				in
				    Origen

	annotation PBI_ResultType = Table

