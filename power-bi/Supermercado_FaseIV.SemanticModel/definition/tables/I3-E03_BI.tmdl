	partition I3-E03_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="SELECT i.CodigoInventario, s.CodigoSucursal, s.Nombre AS Sucursal,#(lf)       p.CodigoProducto, p.Nombre AS Producto, ca.Nombre AS Categoria,#(lf)       i.Existencia,#(lf)       CAST(ROUND(i.Existencia*i.CostoPromedio,2) AS decimal(18,2)) AS ValorCosto,#(lf)       CAST(ROUND(i.Existencia*p.PrecioVenta,2) AS decimal(18,2)) AS ValorVenta#(lf)FROM dbo.Tbl_Inventario AS i#(lf)JOIN dbo.Tbl_Sucursales AS s ON s.CodigoSucursal=i.CodigoSucursal AND s.Estado='Activo'#(lf)JOIN dbo.Tbl_Productos AS p ON p.CodigoProducto=i.CodigoProducto AND p.Estado='Activo'#(lf)JOIN dbo.Tbl_Categorias AS ca ON ca.CodigoCategoria=p.CodigoCategoria AND ca.Estado='Activo'#(lf)ORDER BY ValorCosto DESC, Sucursal, Producto;"])
				in
				    Origen

	annotation PBI_ResultType = Table

