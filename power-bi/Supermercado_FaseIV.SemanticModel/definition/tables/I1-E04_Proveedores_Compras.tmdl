table I1-E04_Proveedores_Compras
	lineageTag: 1af09fa0-3686-5742-9739-ee05f3de4a8f

	column CodigoProveedor
		dataType: int64
		formatString: 0
		lineageTag: d1665c81-1dcd-53c8-b085-6df8b7b59d8d
		summarizeBy: none
		sourceColumn: CodigoProveedor

	column Proveedor
		dataType: string
		lineageTag: e70b2c2a-8879-5053-a1fa-af520401d8b4
		summarizeBy: none
		sourceColumn: Proveedor

	column NumeroCompra
		dataType: string
		lineageTag: 67e28517-3429-5ca6-8ded-0665a0022fbb
		summarizeBy: none
		sourceColumn: NumeroCompra

	column FechaCompra
		dataType: dateTime
		lineageTag: 6e37a454-dff6-5f89-8734-7bad26bc92b4
		summarizeBy: none
		sourceColumn: FechaCompra

	column ImporteCompra
		dataType: double
		formatString: #,0.00
		lineageTag: aecee613-ff39-5d0e-9d07-feaa9bf197a0
		summarizeBy: sum
		sourceColumn: ImporteCompra

		annotation SummarizationSetBy = Automatic

	partition I1-E04_Proveedores_Compras = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="WITH Compras2026 AS (#(lf)    SELECT c.CodigoProveedor, c.NumeroCompra, c.FechaCompra,#(lf)           CAST(ROUND(SUM(d.Cantidad * d.CostoUnitario - d.Descuento), 2) AS decimal(18,2)) AS ImporteCompra#(lf)    FROM dbo.Tbl_Compras AS c#(lf)    JOIN dbo.Tbl_ComprasDetalle AS d ON d.CodigoCompra = c.CodigoCompra#(lf)    WHERE c.Estado = 'Recibida'#(lf)      AND c.FechaCompra >= '20260101' AND c.FechaCompra < '20270101'#(lf)    GROUP BY c.CodigoCompra, c.CodigoProveedor, c.NumeroCompra, c.FechaCompra#(lf))#(lf)SELECT pr.CodigoProveedor, pr.Nombre AS Proveedor,#(lf)       co.NumeroCompra, co.FechaCompra, co.ImporteCompra#(lf)FROM dbo.Tbl_Proveedores AS pr#(lf)LEFT JOIN Compras2026 AS co ON co.CodigoProveedor = pr.CodigoProveedor#(lf)WHERE pr.Estado = 'Activo'#(lf)ORDER BY Proveedor, co.FechaCompra, co.NumeroCompra;"])
				in
				    Origen

	annotation PBI_ResultType = Table

