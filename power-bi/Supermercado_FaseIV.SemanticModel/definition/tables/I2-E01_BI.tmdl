	column AntiguedadAnios
		dataType: int64
		formatString: 0
		lineageTag: 2e0b108b-d9d3-5060-b839-cc67d942b78a
		summarizeBy: none
		sourceColumn: AntiguedadAnios

	partition I2-E01_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="SELECT#(lf)    CodigoCliente,#(lf)    Nombres+' '+Apellidos AS Cliente,#(lf)    Departamento,#(lf)    ISNULL(Correo,'No registrado') AS Correo,#(lf)    LEN(Nombres+' '+Apellidos) AS LongitudNombre,#(lf)    DATEDIFF(YEAR,FechaRegistro,'20260930')-#(lf)        CASE WHEN DATEADD(YEAR,DATEDIFF(YEAR,FechaRegistro,'20260930'),FechaRegistro)>'20260930'#(lf)             THEN 1 ELSE 0 END AS AntiguedadAnios#(lf)FROM Tbl_Clientes#(lf)WHERE Estado='Activo' AND FechaRegistro<'20260701'#(lf)    AND Departamento IN ('Guatemala','Quetzaltenango')#(lf)ORDER BY Departamento ASC, Cliente ASC;"])
				in
				    Origen

	annotation PBI_ResultType = Table

