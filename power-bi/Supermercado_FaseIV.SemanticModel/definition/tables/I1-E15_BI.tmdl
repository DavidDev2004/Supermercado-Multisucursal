table I1-E15_BI
	lineageTag: ae3bd518-3e7c-59de-8dff-8340186ede19

	column Decision
		dataType: string
		lineageTag: f4fdefc6-3996-5d85-af83-cccba72d5b0c
		summarizeBy: none
		sourceColumn: Decision

	column NumeroCompra
		dataType: string
		lineageTag: 78a21da7-f781-5f20-8222-1b9f51da7fb9
		summarizeBy: none
		sourceColumn: NumeroCompra

	column ExisteCompra
		dataType: int64
		formatString: 0
		lineageTag: 8021299b-61c6-56c2-bd12-7afccc964178
		summarizeBy: none
		sourceColumn: ExisteCompra

	column CantidadLineas
		dataType: int64
		formatString: 0
		lineageTag: 3f7b8dde-d29c-505e-addf-dd0e9ce6baa9
		summarizeBy: none
		sourceColumn: CantidadLineas

	column ImporteCompra
		dataType: double
		formatString: #,0.00
		lineageTag: 3d1f8770-d542-54a9-b352-9eca67cf191a
		summarizeBy: sum
		sourceColumn: ImporteCompra

	partition I1-E15_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate_PRUEBAS", [Query="WITH Practicas AS (#(lf)    SELECT v.Decision, v.NumeroCompra#(lf)    FROM (VALUES#(lf)        ('NO', 'I1-E15-3056D4F7E68445568C069E'),#(lf)        ('SI', 'I1-E15-E7F1AC0CB0BB416AB825B7')#(lf)    ) AS v(Decision, NumeroCompra)#(lf))#(lf)SELECT p.Decision, p.NumeroCompra,#(lf)       CASE WHEN c.CodigoCompra IS NULL THEN 0 ELSE 1 END AS ExisteCompra,#(lf)       (SELECT COUNT(*) FROM dbo.Tbl_ComprasDetalle AS d WHERE d.CodigoCompra = c.CodigoCompra) AS CantidadLineas,#(lf)       CAST(COALESCE((SELECT SUM(d.Cantidad * d.CostoUnitario - d.Descuento)#(lf)                      FROM dbo.Tbl_ComprasDetalle AS d WHERE d.CodigoCompra = c.CodigoCompra), 0) AS decimal(18,2)) AS ImporteCompra#(lf)FROM Practicas AS p#(lf)LEFT JOIN dbo.Tbl_Compras AS c ON c.NumeroCompra = p.NumeroCompra;"])
				in
				    Origen

	annotation PBI_ResultType = Table

