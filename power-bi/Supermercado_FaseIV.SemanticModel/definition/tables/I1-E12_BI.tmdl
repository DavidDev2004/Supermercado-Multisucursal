	column DiasAtraso
		dataType: int64
		formatString: 0
		lineageTag: 09b4df00-2434-50a7-b922-bc500c1367ba
		summarizeBy: none
		sourceColumn: DiasAtraso

	column NivelAtraso
		dataType: string
		lineageTag: f3b8ad63-2801-5d72-8488-7cb175d08d90
		summarizeBy: none
		sourceColumn: NivelAtraso

	partition I1-E12_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="SELECT c.CodigoCompra, c.NumeroCompra, c.CodigoSucursal,#(lf)       DATEDIFF(DAY, c.FechaEntregaProgramada, c.FechaRecepcion) AS DiasAtraso,#(lf)       CASE WHEN c.FechaRecepcion <= c.FechaEntregaProgramada THEN 'A tiempo'#(lf)            WHEN DATEDIFF(DAY, c.FechaEntregaProgramada, c.FechaRecepcion) <= 2 THEN 'Leve'#(lf)            WHEN DATEDIFF(DAY, c.FechaEntregaProgramada, c.FechaRecepcion) <= 5 THEN 'Medio'#(lf)            ELSE 'Alto' END AS NivelAtraso#(lf)FROM dbo.Tbl_Compras AS c#(lf)WHERE c.Estado = 'Recibida' AND c.FechaRecepcion IS NOT NULL#(lf)ORDER BY DiasAtraso DESC, c.NumeroCompra;"])
				in
				    Origen

	annotation PBI_ResultType = Table

