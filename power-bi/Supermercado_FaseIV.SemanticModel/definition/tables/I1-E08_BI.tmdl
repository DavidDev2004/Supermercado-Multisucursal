	column CostoNeto
		dataType: double
		formatString: #,0.00
		lineageTag: 5a792fda-8058-5377-8d53-9f418f61d06b
		summarizeBy: sum
		sourceColumn: CostoNeto

	partition I1-E08_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="SELECT p.CodigoCategoria, ca.Nombre AS Categoria,#(lf)       YEAR(c.FechaCompra) AS Anio, MONTH(c.FechaCompra) AS Mes,#(lf)       COUNT(*) AS CantidadLineas,#(lf)       SUM(d.Cantidad) AS UnidadesCompradas,#(lf)       CAST(ROUND(SUM(d.Cantidad * d.CostoUnitario - d.Descuento), 2) AS decimal(18,2)) AS CostoNeto#(lf)FROM dbo.Tbl_Compras AS c#(lf)JOIN dbo.Tbl_ComprasDetalle AS d ON d.CodigoCompra = c.CodigoCompra#(lf)JOIN dbo.Tbl_Productos AS p ON p.CodigoProducto = d.CodigoProducto#(lf)JOIN dbo.Tbl_Categorias AS ca ON ca.CodigoCategoria = p.CodigoCategoria#(lf)WHERE c.Estado = 'Recibida' AND c.FechaCompra >= '20260101' AND c.FechaCompra < '20270101'#(lf)GROUP BY p.CodigoCategoria, ca.Nombre, YEAR(c.FechaCompra), MONTH(c.FechaCompra)#(lf)HAVING COUNT(*) >= 2#(lf)   AND SUM(d.Cantidad * d.CostoUnitario - d.Descuento) > 500#(lf)ORDER BY Anio, Mes, Categoria;"])
				in
				    Origen

	annotation PBI_ResultType = Table

