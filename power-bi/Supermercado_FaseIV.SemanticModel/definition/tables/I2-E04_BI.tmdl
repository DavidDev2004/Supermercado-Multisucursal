table I2-E04_BI
	lineageTag: fd6b60aa-4a37-5cbf-b203-0db5d52c651e

	column CodigoCliente
		dataType: int64
		formatString: 0
		lineageTag: 5a023b82-68e3-53d9-8b77-1e90c7e97844
		summarizeBy: none
		sourceColumn: CodigoCliente

	column Cliente
		dataType: string
		lineageTag: 8330bec4-9d80-5317-96eb-e04af3bb5461
		summarizeBy: none
		sourceColumn: Cliente

	column NumeroVenta
		dataType: string
		lineageTag: 3229aec9-123b-5cc1-b362-b169e2afbb44
		summarizeBy: none
		sourceColumn: NumeroVenta

	column FechaVenta
		dataType: dateTime
		lineageTag: fbf998dc-25ea-51eb-9c0c-ddedd22b02d6
		summarizeBy: none
		sourceColumn: FechaVenta

	column TotalVenta
		dataType: double
		formatString: #,0.00
		lineageTag: 2ec85d8a-ff05-5626-8a87-35a68899d48f
		summarizeBy: sum
		sourceColumn: TotalVenta

	partition I2-E04_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="SELECT#(lf)    C.CodigoCliente,#(lf)    C.Nombres+' '+C.Apellidos AS Cliente,#(lf)    V.NumeroVenta,#(lf)    V.FechaVenta,#(lf)    CAST(ROUND((SELECT SUM(D.Cantidad*D.PrecioUnitario-D.Descuento)#(lf)           FROM Tbl_VentasDetalle D WHERE D.CodigoVenta=V.CodigoVenta),2) AS DECIMAL(18,2)) AS TotalVenta#(lf)FROM Tbl_Clientes C#(lf)LEFT JOIN Tbl_Ventas V ON V.CodigoCliente=C.CodigoCliente#(lf)    AND V.Estado='Confirmada'#(lf)    AND V.FechaVenta>='20260101' AND V.FechaVenta<'20270101'#(lf)WHERE C.Estado='Activo'#(lf)ORDER BY Cliente ASC, V.FechaVenta ASC;"])
				in
				    Origen

	annotation PBI_ResultType = Table

