	partition I3-E04_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="SELECT p.CodigoProducto, p.Nombre AS Producto,#(lf)       i.CodigoSucursal, i.Existencia, i.ExistenciaMinima#(lf)FROM dbo.Tbl_Productos AS p#(lf)LEFT JOIN dbo.Tbl_Inventario AS i ON i.CodigoProducto=p.CodigoProducto#(lf)WHERE p.Estado='Activo'#(lf)ORDER BY Producto, i.CodigoSucursal;"])
				in
				    Origen

	annotation PBI_ResultType = Table

