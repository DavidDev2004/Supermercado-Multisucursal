	partition I3-E15_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate_PRUEBAS", [Query="WITH Practicas AS (#(lf)    SELECT v.Decision, v.NumeroAjuste#(lf)    FROM (VALUES#(lf)        ('NO', 'I3-E15-E164A13A540348E8A8B38F'),#(lf)        ('SI', 'I3-E15-7F01845DDB7B4090BFA76E')#(lf)    ) AS v(Decision, NumeroAjuste)#(lf))#(lf)SELECT p.Decision, p.NumeroAjuste,#(lf)       CASE WHEN a.CodigoAjuste IS NULL THEN 0 ELSE 1 END AS ExisteAjuste,#(lf)       (SELECT COUNT(*) FROM dbo.Tbl_AjustesInventarioDetalle AS d WHERE d.CodigoAjuste = a.CodigoAjuste) AS CantidadLineas,#(lf)       CAST(NULL AS decimal(18,2)) AS Antes,#(lf)       (SELECT i.Existencia FROM dbo.Tbl_Inventario AS i WHERE i.CodigoInventario = 1) AS Despues#(lf)FROM Practicas AS p#(lf)LEFT JOIN dbo.Tbl_AjustesInventario AS a ON a.NumeroAjuste = p.NumeroAjuste;"])
				in
				    Origen

	annotation PBI_ResultType = Table

