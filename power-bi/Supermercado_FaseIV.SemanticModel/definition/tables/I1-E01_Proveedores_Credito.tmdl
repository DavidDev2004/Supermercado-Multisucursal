	column AntiguedadAnios
		dataType: int64
		formatString: 0
		lineageTag: 557cd667-527e-4a87-b872-f16031bb402b
		summarizeBy: sum
		sourceColumn: AntiguedadAnios

		annotation SummarizationSetBy = Automatic

	partition I1-E01_Proveedores_Credito = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="#(lf)SELECT#(lf)    pr.CodigoProveedor,#(lf)    UPPER(pr.Nombre) AS Proveedor,#(lf)    pr.Departamento,#(lf)    pr.DiasCredito,#(lf)    ISNULL(pr.Correo, 'No registrado') AS Correo,#(lf)    DATEDIFF(YEAR, pr.FechaRegistro, '20260930')#(lf)    - CASE#(lf)        WHEN DATEADD(#(lf)            YEAR,#(lf)            DATEDIFF(YEAR, pr.FechaRegistro, '20260930'),#(lf)            pr.FechaRegistro#(lf)        ) > '20260930'#(lf)        THEN 1 ELSE 0#(lf)      END AS AntiguedadAnios#(lf)FROM dbo.Tbl_Proveedores AS pr#(lf)WHERE pr.Estado = 'Activo'#(lf)  AND pr.DiasCredito BETWEEN 15 AND 60#(lf)  AND (#(lf)      pr.Nombre LIKE '%Guatemala%'#(lf)      OR pr.Nombre LIKE '%GT%'#(lf)  );"])
				in
				    Origen

	changedProperty = Name

	annotation PBI_ResultType = Table

