	partition I2-E02_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="SELECT#(lf)    CodigoPago,#(lf)    UPPER(Comprobante) AS Comprobante,#(lf)    FechaPago,#(lf)    YEAR(FechaPago) AS Anio,#(lf)    MONTH(FechaPago) AS Mes,#(lf)    MetodoPago,#(lf)    ISNULL(Autorizacion,'Sin autorizacion') AS Autorizacion,#(lf)    ROUND(Monto,2) AS Monto,#(lf)    ROUND(Comision,2) AS Comision,#(lf)    ROUND(Monto-Comision,2) AS MontoNeto#(lf)FROM Tbl_Pagos#(lf)WHERE Estado='Aplicado'#(lf)    AND FechaPago>='20260701' AND FechaPago<'20261001'#(lf)    AND MetodoPago IN ('Efectivo','Tarjeta') AND Monto>50#(lf)ORDER BY FechaPago DESC;"])
				in
				    Origen

	annotation PBI_ResultType = Table

