	column TotalVenta
		dataType: double
		formatString: #,0.00
		lineageTag: 524f30b5-b3ef-50f1-b9f5-9206f97674c4
		summarizeBy: sum
		sourceColumn: TotalVenta

	partition I2-E05_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="SELECT#(lf)    CodigoVenta,#(lf)    NumeroVenta,#(lf)    FechaVenta,#(lf)    CodigoSucursal,#(lf)    CAST(ROUND((SELECT SUM(Cantidad*PrecioUnitario-Descuento)#(lf)           FROM Tbl_VentasDetalle D WHERE D.CodigoVenta=V.CodigoVenta),2) AS DECIMAL(18,2)) AS TotalVenta#(lf)FROM Tbl_Ventas V#(lf)WHERE Estado='Confirmada'#(lf)    AND (SELECT SUM(Cantidad*PrecioUnitario-Descuento)#(lf)         FROM Tbl_VentasDetalle D WHERE D.CodigoVenta=V.CodigoVenta)>#(lf)        (SELECT AVG(TotalVenta)#(lf)         FROM#(lf)            (SELECT SUM(D2.Cantidad*D2.PrecioUnitario-D2.Descuento) AS TotalVenta#(lf)             FROM Tbl_Ventas V2#(lf)             INNER JOIN Tbl_VentasDetalle D2 ON D2.CodigoVenta=V2.CodigoVenta#(lf)             WHERE V2.Estado='Confirmada'#(lf)             GROUP BY V2.CodigoVenta) T)#(lf)ORDER BY TotalVenta DESC;"])
				in
				    Origen

	annotation PBI_ResultType = Table

