		lineageTag: 4c781f75-b847-53cf-a67e-59a49d150d61
		summarizeBy: none
		sourceColumn: DiasAtraso

	column LongitudNumero
		dataType: int64
		formatString: 0
		lineageTag: 30410386-7a37-5fa1-9aa9-b1370e7556fb
		summarizeBy: none
		sourceColumn: LongitudNumero

	partition I1-E02_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="SELECT c.CodigoCompra, c.NumeroCompra,#(lf)       YEAR(c.FechaCompra) AS Anio, MONTH(c.FechaCompra) AS Mes,#(lf)       c.FechaEntregaProgramada, c.FechaRecepcion,#(lf)       DATEDIFF(DAY, c.FechaEntregaProgramada, c.FechaRecepcion) AS DiasAtraso,#(lf)       LEN(c.NumeroCompra) AS LongitudNumero#(lf)FROM dbo.Tbl_Compras AS c#(lf)WHERE c.Estado = 'Recibida'#(lf)  AND c.FechaCompra >= '20260701' AND c.FechaCompra < '20261001'#(lf)  AND c.FechaRecepcion > c.FechaEntregaProgramada#(lf)ORDER BY DiasAtraso DESC, c.NumeroCompra;"])
				in
				    Origen

	annotation PBI_ResultType = Table

