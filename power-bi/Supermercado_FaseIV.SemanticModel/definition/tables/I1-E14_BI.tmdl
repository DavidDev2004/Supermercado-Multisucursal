	partition I1-E14_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate_PRUEBAS", [Query="SELECT pp.CodigoProductoProveedor, pp.CodigoProveedor, pp.CodigoProducto,#(lf)       pr.Nombre AS Proveedor, p.Nombre AS Producto,#(lf)       CAST(pp.CostoReferencia AS decimal(18,2)) AS CostoReferencia#(lf)FROM dbo.Tbl_ProductoProveedor AS pp#(lf)JOIN dbo.Tbl_Proveedores AS pr ON pr.CodigoProveedor = pp.CodigoProveedor#(lf)JOIN dbo.Tbl_Productos AS p ON p.CodigoProducto = pp.CodigoProducto#(lf)WHERE pp.CodigoProductoProveedor = 1;"])
				in
				    Origen

	annotation PBI_ResultType = Table

