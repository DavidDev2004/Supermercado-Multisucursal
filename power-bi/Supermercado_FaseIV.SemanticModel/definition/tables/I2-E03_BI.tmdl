	column Saldo
		dataType: double
		formatString: #,0.00
		lineageTag: b900dd96-c6ae-598c-b1fd-3fa26668c176
		summarizeBy: sum
		sourceColumn: Saldo

	partition I2-E03_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="SELECT#(lf)    V.CodigoVenta,#(lf)    V.NumeroVenta,#(lf)    V.FechaVenta,#(lf)    C.Nombres+' '+C.Apellidos AS Cliente,#(lf)    S.Nombre AS Sucursal,#(lf)    E.Nombres+' '+E.Apellidos AS Empleado,#(lf)    CAST(ROUND((SELECT SUM(D.Cantidad*D.PrecioUnitario-D.Descuento)#(lf)           FROM Tbl_VentasDetalle D WHERE D.CodigoVenta=V.CodigoVenta),2) AS DECIMAL(18,2)) AS TotalVenta,#(lf)    CAST(ROUND(ISNULL((SELECT SUM(P.Monto) FROM Tbl_Pagos P#(lf)                  WHERE P.CodigoVenta=V.CodigoVenta AND P.Estado='Aplicado'),0),2) AS DECIMAL(18,2)) AS TotalPagado,#(lf)    CAST(ROUND((SELECT SUM(D.Cantidad*D.PrecioUnitario-D.Descuento)#(lf)           FROM Tbl_VentasDetalle D WHERE D.CodigoVenta=V.CodigoVenta)#(lf)          -ISNULL((SELECT SUM(P.Monto) FROM Tbl_Pagos P#(lf)                   WHERE P.CodigoVenta=V.CodigoVenta AND P.Estado='Aplicado'),0),2) AS DECIMAL(18,2)) AS Saldo#(lf)FROM Tbl_Ventas V#(lf)INNER JOIN Tbl_Clientes C ON C.CodigoCliente=V.CodigoCliente#(lf)INNER JOIN Tbl_Sucursales S ON S.CodigoSucursal=V.CodigoSucursal#(lf)INNER JOIN Tbl_Empleados E ON E.CodigoEmpleado=V.CodigoEmpleado#(lf)WHERE V.Estado='Confirmada' AND V.FechaVenta>='20260901' AND V.FechaVenta<'20261001'#(lf)ORDER BY Saldo DESC;"])
				in
				    Origen

	annotation PBI_ResultType = Table

