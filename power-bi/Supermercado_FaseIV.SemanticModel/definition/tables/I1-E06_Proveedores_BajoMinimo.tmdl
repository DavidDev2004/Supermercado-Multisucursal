	partition I1-E06_Proveedores_BajoMinimo = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="SELECT pr.CodigoProveedor, pr.Nombre AS Proveedor, pr.Contacto,#(lf)       pr.Telefono, pr.Departamento#(lf)FROM dbo.Tbl_Proveedores AS pr#(lf)WHERE pr.Estado = 'Activo'#(lf)  AND EXISTS (#(lf)      SELECT 1#(lf)      FROM dbo.Tbl_ProductoProveedor AS pp#(lf)      WHERE pp.CodigoProveedor = pr.CodigoProveedor#(lf)        AND pp.Estado = 'Activo'#(lf)        AND pp.CodigoProducto IN (#(lf)            SELECT i.CodigoProducto FROM dbo.Tbl_Inventario AS i#(lf)            WHERE i.Existencia < i.ExistenciaMinima#(lf)        )#(lf)  )#(lf)ORDER BY pr.Departamento, Proveedor;"])
				in
				    Origen

	annotation PBI_ResultType = Table

