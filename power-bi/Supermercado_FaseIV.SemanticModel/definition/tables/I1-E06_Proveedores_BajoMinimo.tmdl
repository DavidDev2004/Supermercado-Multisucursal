		lineageTag: 60b9dc79-1bbb-5623-b80a-d973d46d051f
		summarizeBy: none
		sourceColumn: Contacto

	column Telefono
		dataType: string
		lineageTag: 600afe84-f4aa-5a2c-bcf7-dd996a602709
