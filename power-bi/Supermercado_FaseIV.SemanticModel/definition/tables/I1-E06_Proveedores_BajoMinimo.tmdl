table I1-E06_Proveedores_BajoMinimo
	lineageTag: f59845df-64bc-55b8-8d4e-e8754f8e7520

	column CodigoProveedor
		dataType: int64
		formatString: 0
		lineageTag: 0b1535b2-0fa8-5711-8999-8af2e7424fa4
