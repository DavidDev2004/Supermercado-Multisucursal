table I3-E01_BI
	lineageTag: 77552d46-9df5-503f-a2d3-023500a7f628

	column CodigoProducto
		dataType: int64
		formatString: 0
		lineageTag: ee3adbfd-b78c-5ee9-a71e-82a1ece2edb6
		summarizeBy: none
		sourceColumn: CodigoProducto

	column Producto
		dataType: string
		lineageTag: c4af970f-e8ba-5f4e-85f4-c587a55666e6
		summarizeBy: none
		sourceColumn: Producto

	column Marca
		dataType: string
		lineageTag: d6e8bbdf-bd6b-5e62-911f-f50b19da041b
		summarizeBy: none
		sourceColumn: Marca

	column PrecioVenta
		dataType: double
		formatString: #,0.00
		lineageTag: fd036572-1794-5701-b1ff-d528ca2dda99
		summarizeBy: sum
		sourceColumn: PrecioVenta

	column LongitudNombre
		dataType: int64
		formatString: 0
		lineageTag: 6ed0eb8a-8354-5781-b7e6-58ae8724cbec
		summarizeBy: none
		sourceColumn: LongitudNombre

	column DiasRegistrado
		dataType: int64
		formatString: 0
		lineageTag: 039b031a-ed07-5573-9cee-4dc8077d4d20
		summarizeBy: none
		sourceColumn: DiasRegistrado

	partition I3-E01_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="SELECT p.CodigoProducto, UPPER(p.Nombre) AS Producto,#(lf)       LOWER(p.Marca) AS Marca,#(lf)       CAST(p.PrecioVenta AS decimal(18,2)) AS PrecioVenta,#(lf)       LEN(p.Nombre) AS LongitudNombre,#(lf)       DATEDIFF(DAY,p.FechaRegistro,'20260930') AS DiasRegistrado#(lf)FROM dbo.Tbl_Productos AS p#(lf)WHERE p.Estado='Activo' AND p.PrecioVenta BETWEEN 10 AND 100#(lf)  AND (p.Marca LIKE '%GT%' OR p.Marca LIKE '%Guatemala%')#(lf)ORDER BY DiasRegistrado DESC, Producto;"])
				in
				    Origen

	annotation PBI_ResultType = Table

