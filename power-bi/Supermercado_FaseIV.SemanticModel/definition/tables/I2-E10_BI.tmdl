table I2-E10_BI
	lineageTag: f742e895-4856-5541-99e7-a1671c0e2de0

	column CodigoCliente
		dataType: int64
		formatString: 0
		lineageTag: bd1066cd-0c20-5fcc-87f6-53255deb7436
		summarizeBy: none
		sourceColumn: CodigoCliente

	column Cliente
		dataType: string
		lineageTag: c13cad74-3f7c-5810-b197-d51b2c3754c2
		summarizeBy: none
		sourceColumn: Cliente

	partition I2-E10_BI = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost,1435", "SupermercadosGuate", [Query="SELECT#(lf)    C.CodigoCliente,#(lf)    C.Nombres+' '+C.Apellidos AS Cliente#(lf)FROM Tbl_Clientes C#(lf)INNER JOIN Tbl_Ventas V ON V.CodigoCliente=C.CodigoCliente#(lf)WHERE V.Estado='Confirmada'#(lf)    AND V.FechaVenta>='20260101' AND V.FechaVenta<'20260701'#(lf)#(lf)INTERSECT#(lf)#(lf)SELECT#(lf)    C.CodigoCliente,#(lf)    C.Nombres+' '+C.Apellidos AS Cliente#(lf)FROM Tbl_Clientes C#(lf)INNER JOIN Tbl_Ventas V ON V.CodigoCliente=C.CodigoCliente#(lf)WHERE V.Estado='Confirmada'#(lf)    AND V.FechaVenta>='20260701' AND V.FechaVenta<'20261001'#(lf)ORDER BY Cliente ASC;"])
				in
				    Origen

	annotation PBI_ResultType = Table

